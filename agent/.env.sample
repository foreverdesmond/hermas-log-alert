# Copy to the untracked, visible file config.env and replace every placeholder.
# In Portainer, add the same names and values in the Stack environment section.
# Never commit config.env or a real .env file.

# HTTPS endpoint implemented by hermes-service.
HERMES_WEBHOOK_URL=https://hermes.example.com/webhooks/log-alert

# Shared signing secret. Generate a long random value; never reuse this example.
HERMES_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Stable name displayed in alerts.
ALERT_HOST=mac-mini

# Absolute macOS path that is bind-mounted into Logtail as read-only /logs.
LOGS_DIR=/Volumes/Data/Logs
