 func (d *WebhookTransfer) Trans(source string, data ...[]byte) error {
+	// The upstream webhook transfer drops the source path and forwards raw text.
+	// Keep this compact envelope so the gateway can group incidents by service.
+	if d.batcher == nil {
+		payload, err := json.Marshal(struct {
+			Source  string `json:"source"`
+			Message string `json:"message"`
+		}{
+			Source:  source,
+			Message: string(bytes.Join(data, []byte("\n"))),
+		})
+		if err != nil {
+			return err
+		}
+		return httpTransWithClient(d.client, d.url, payload)
+	}
 	if d.batcher != nil {
 		for _, b := range data {
 			d.batcher.Add(source, b)
