# This is the visible-file variant of .env.sample.
# Copy to config.env, replace every placeholder, and keep config.env private.

HERMES_WEBHOOK_URL=https://hermes.example.com/webhooks/log-alert
HERMES_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Linux: /var/log/my-app | macOS: /Volumes/Data/Logs | Windows: C:/Logs/my-app
ALERT_HOST=docker-host
LOGS_DIR=/var/log/my-app
